AUTH_STRAVA_ID=your-strava-id # strava app client id (see https://developers.strava.com/docs/getting-started/#account)
AUTH_STRAVA_SECRET=your-strava-secret # strava app secret (see https://developers.strava.com/docs/getting-started/#account)
DATABASE_URL="postgresql://[username]:[password]@[host]:[port]/[database]"
BETTER_AUTH_SECRET=your-better-auth-secret # at least 32 characters; generate with: openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3000 # optional; full URL of the app. Leave unset to derive it from each request
